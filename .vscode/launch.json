    {
      "type": "java",
      "name": "Spring Boot-ServiceDescoveryApplication<service-descovery>",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "mainClass": "br.com.leticiafarias.service_descovery.ServiceDescoveryApplication",
      "projectName": "service-descovery",
      "args": "",
      "envFile": "${workspaceFolder}/.env",
